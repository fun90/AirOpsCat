[Unit]
Description=AirOpsCat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=airopscat
Group=airopscat
WorkingDirectory=/var/lib/airopscat
EnvironmentFile=/etc/airopscat/airopscat.env
EnvironmentFile=/etc/airopscat/initial-admin.env
ExecStart=/usr/local/bin/airopscat
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
StateDirectory=airopscat
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/airopscat
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
