{
  "type": "hysteria2",
  "users": [],
  "up_mbps": 50,
  "down_mbps": 50,
  "tls": {
    "server_name": "{serverName}",
    "enabled": true,
    "alpn": [
      "h3"
    ],
    "certificate_path": "/usr/local/etc/certs/fullchain.cer",
    "key_path": "/usr/local/etc/certs/private.key"
  },
  "obfs": {
    "type": "salamander",
    "password": "{password}"
  },
  "masquerade": {
    "type": "proxy",
      "url": "https://{serverName}/",
      "rewrite_host": true
  }
}
