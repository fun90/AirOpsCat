{
  "type": "vless",
  "sniff": true,
  "sniff_override_destination": true,
  "domain_strategy": "prefer_ipv4",
  "users": [],
  "tls": {
    "enabled": true,
    "server_name": "{serverName}",
    "certificate_path": "/usr/local/etc/certs/fullchain.cer",
    "key_path": "/usr/local/etc/certs/private.key",
    "min_version": "1.2",
    "max_version": "1.3",
    "alpn": [
      "h2",
      "http/1.1"
    ]
  }
}
