{
  "protocol": "vless",
  "settings": {
    "clients": [],
    "decryption": "none",
    "fallbacks": [
      {
        "dest": "7001",
        "xver": 1
      },
      {
        "alpn": "h2",
        "dest": "7002",
        "xver": 1
      }
    ]
  },
  "streamSettings": {
    "network": "tcp",
    "security": "tls",
    "tlsSettings": {
      "rejectUnknownSni": true,
      "minVersion": "1.2",
      "certificates": [
        {
          "ocspStapling": 3600,
          "certificateFile": "/usr/local/etc/certs/xray.crt",
          "keyFile": "/usr/local/etc/certs/xray.key"
        }
      ]
    }
  },
  "sniffing": {
    "enabled": true,
    "destOverride": [
      "http",
      "tls"
    ]
  }
}
