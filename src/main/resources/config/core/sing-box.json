{
  "log": {
    "level": "info",
    "output": "/var/lib/sing-box/box.log",
    "timestamp": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:19191",
      "secret": "{clashApiSecret}"
    },
    "cache_file": {
      "enabled": true,
      "path": "/var/lib/sing-box/cache.db",
      "cache_id": "airopscat"
    },
    "v2ray_api": {
      "listen": "127.0.0.1:101",
      "stats": {
        "enabled": true{#if hasStatsUsers},
        "users": {statsUsers}{/if}
      }
    }
  },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "google",
        "server": "8.8.8.8"
      }
    ]
  },
  "inbounds": [
    {#if hasExtraInbounds}
    {extraInbounds}
    {/if}
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "default-direct"
    },
    {
      "type": "block",
      "tag": "default-blocked"
    }{#if hasExtraOutbounds},
    {extraOutbounds}
    {/if}
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "domain": [ "bam.nr-data.net" ],
        "action": "reject"
      },
      {
        "action": "resolve",
        "strategy": "prefer_ipv4"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "reject"
      },
      {
        "domain_suffix": [ "gstatic.com" ],
        "action": "route",
        "outbound": "default-direct"
      },
      {
        "rule_set": ["geoip-cn", "geosite-cn"],
        "action": "reject"
      }{#if hasExtraRouteRules},
      {extraRouteRules}
      {/if}
    ],
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/refs/heads/rule-set/geoip-cn.srs",
        "download_detour": "default-direct"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/refs/heads/rule-set/geosite-cn.srs",
        "download_detour": "default-direct"
      }
      {#if hasExtraRuleSets},
      {extraRuleSets}
      {/if}
    ]
  }
}
