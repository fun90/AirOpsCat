{
  "log": {
    "level": "error",
    "timestamp": true
  },
  "inbounds": [
    {#if hasExtraInbounds}
    {extraInbounds}
    {/if}
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "default-direct"
    },
    {
      "type": "block",
      "tag": "default-blocked"
    }{#if hasExtraOutbounds},
    {extraOutbounds}
    {/if}
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "geoip": [
          "private",
          "cn"
        ],
        "action": "reject" 
      },
      {
        "geosite": ["cn"],
        "action": "reject"
      }{#if hasExtraRouteRules},
      {extraRouteRules}
      {/if}
    ]
  }
}
