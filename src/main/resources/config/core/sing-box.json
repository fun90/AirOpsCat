{
  "log": {
    "level": "info",
    "output": "/var/lib/sing-box/box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "tls",
        "tag": "google",
        "server": "8.8.8.8"
      }
    ]
  },
  "inbounds": [
    {#if hasExtraInbounds}
    {extraInbounds}
    {/if}
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "default-direct"
    },
    {
      "type": "block",
      "tag": "default-blocked"
    }{#if hasExtraOutbounds},
    {extraOutbounds}
    {/if}
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "reject"
      },
      {
        "domain_suffix": [ "gstatic.com" ],
        "action": "route",
        "outbound": "default-direct"
      },
      {
        "rule_set": ["geoip-cn", "geosite-cn"],
        "action": "reject"
      }{#if hasExtraRouteRules},
      {extraRouteRules}
      {/if}
    ],
    "rule_set": [
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/refs/heads/rule-set/geoip-cn.srs",
        "download_detour": "default-direct"
      },
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/refs/heads/rule-set/geosite-cn.srs",
        "download_detour": "default-direct"
      }
    ]
  }
}
