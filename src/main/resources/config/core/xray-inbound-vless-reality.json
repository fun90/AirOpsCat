{
  "protocol": "vless",
  "settings": {
    "clients": [],
    "decryption": "none"
  },
  "streamSettings": {
    "network": "tcp",
    "security": "reality",
    "realitySettings": {
      "show": false,
      "dest": "{selectedDest}:443",
      "serverNames": [
        "{selectedDest}"
      ],
      "privateKey": "{privateKey}",
      "publicKey": "{publicKey}",
      "shortIds": [
        "{shortId}"
      ]
    }
  },
  "sniffing": {
    "enabled": true,
    "destOverride": [
      "http",
      "tls",
      "quic"
    ],
    "routeOnly": true
  }
}
