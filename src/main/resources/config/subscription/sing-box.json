{
  "log": {
    "disabled": false,
    "level": "error",
    "output": "",
    "timestamp": false
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": [
        "172.19.0.1/30"
      ],
      "mtu": 9000,
      "auto_route": true,
      "strict_route": true,
      "stack": "system",
      "platform": {
        "http_proxy": {
          "enabled": true,
          "server": "127.0.0.1",
          "server_port": 8090
        }
      }
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 8090
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🎈 自动选择",
        {#for node in nodes}
        "{node.name}"{#if node_hasNext},{/if}
        {/for}
      ]
    },
    {
      "type": "urltest",
      "tag": "🎈 自动选择",
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 150,
      "interrupt_exist_connections": true,
      "outbounds": [
        {#for node in nodes}
        "{node.name}"{#if node_hasNext},{/if}
        {/for}
      ]
    },
    {
      "tag": "🪟 Microsoft",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎈 自动选择",
        {#for node in nodes}"{node.name}",{/for}
        "🎯 全球直连"
      ]
    },
    {
      "tag": "🐬 OneDrive",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎈 自动选择",
        {#for node in nodes}
        "{node.name}"{#if node_hasNext},{/if}
        {/for}
      ]
    },
    {
      "tag": "🍏 Apple",
      "type": "selector",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🎯 全球直连",
        {#for node in nodes}
        "{node.name}"{#if node_hasNext},{/if}
        {/for}
      ]
    },
    {
      "type": "direct",
      "tag": "🎯 全球直连"
    },
    {
      "type": "selector",
      "tag": "🐟 漏网之鱼",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎯 全球直连"
      ]
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 节点选择",
        "🎈 自动选择",
        "🎯 全球直连",
        "🐟 漏网之鱼"
      ]
    },
    {#for node in nodes}
    {
      "tag": "{node.name}",
      {#if node.protocol == 'hysteria2' && node.coreType == 'sing-box'}
      "type": "hysteria2",
      "server": "{node.serverHost}",
      "server_port": {node.port},
      "password": "{account.uuid}",
      "obfs": {
          "type": "salamander",
          "password": "{password}"
      },
      "tls": {
        "enabled": true,
        "insecure": true,
        "server_name": "{node.inbound.tls.server_name}",
        "alpn": [
          "h3"
        ]
      }
      {#else if node.protocol == 'shadowtls' && node.coreType == 'sing-box'}
      "type": "shadowtls",
      "server": "{node.serverHost}",
      "server_port": {node.port},
      "version": {node.inbound.version},
      "password": "{account.uuid}",
      "tls": {
        "enabled": true,
        "insecure": true,
        "server_name": "{node.inbound.handshake.server}"
      }
      {#else}
      "type": "vless",
      "server": "{node.serverHost}",
      "server_port": {node.port},
      "uuid": "{account.uuid}",
      "tls": {
        "enabled": true,
        "insecure": true,
        {#if node.protocol == 'vless-reality'}
        {#if node.coreType == 'sing-box'}
        "server_name": "{node.inbound.tls.server_name}",
        "reality": {
          "enabled": true,
          "public_key": "{node.inbound.tls.reality.public_key}",
          "short_id": "{node.inbound.tls.reality.short_id[0]}"
        },
        {#else if node.coreType == 'xray'}
        "server_name": "{node.inbound.streamSettings.realitySettings.serverNames[0]}",
        "reality": {
          "enabled": true,
          "public_key": "{node.inbound.streamSettings.realitySettings.publicKey}",
          "short_id": "{node.inbound.streamSettings.realitySettings.shortIds[0]}"
        },
        {/if}
        {#else}
        "server_name": "{node.serverHost}",
        {/if}
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
      },
      "flow": "xtls-rprx-vision"
      {/if}
    }{#if node_hasNext},{/if}
    {/for}
  ],
  "route": {
    "rules": [
      {
        "action": "sniff",
        "inbound": "tun-in"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "action": "route",
        "clash_mode": "direct",
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "clash_mode": "global",
        "outbound": "GLOBAL"
      },
      {
        "action": "reject",
        "protocol": "quic"
      },
      {
        "action": "route",
        "domain": [
          "clash.razord.top",
          "yacd.metacubex.one",
          "yacd.haishan.me",
          "d.metacubex.one"
        ],
        "rule_set": [
          "GeoSite-Private",
          "GeoIP-Private"
        ],
        "outbound": "🎯 全球直连"
      },
      {
        "action": "route",
        "rule_set": "geosite-onedrive",
        "outbound": "🐬 OneDrive"
      },
      {
        "action": "route",
        "rule_set": "geosite-microsoft",
        "outbound": "🪟 Microsoft"
      },
      {
        "action": "route",
        "rule_set": [
          "geoip-apple",
          "geosite-apple"
        ],
        "outbound": "🍏 Apple"
      },
      {
        "action": "route",
        "rule_set": [
          "GeoSite-CN",
          "GeoIP-CN"
        ],
        "outbound": "🎯 全球直连"
      }
    ],
    "rule_set": [
      {
        "tag": "GeoIP-Private",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/private.srs",
        "format": "binary",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "GeoSite-Private",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/private.srs",
        "format": "binary",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "GeoIP-CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geoip/cn.srs",
        "format": "binary",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "GeoSite-CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/cn.srs",
        "format": "binary",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "GeoLocation-!CN",
        "type": "remote",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/geolocation-!cn.srs",
        "format": "binary",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-apple",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/apple.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-microsoft",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/microsoft.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geosite-onedrive",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo/geosite/onedrive.srs",
        "download_detour": "🎯 全球直连"
      },
      {
        "tag": "geoip-apple",
        "type": "remote",
        "format": "binary",
        "url": "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@sing/geo-lite/geoip/apple.srs",
        "download_detour": "🎯 全球直连"
      }
    ],
    "auto_detect_interface": true,
    "final": "🐟 漏网之鱼"
  },
  "dns": {
    "servers": [
      {
        "tag": "proxyDns",
        "address": "https://cloudflare-dns.com/dns-query",
        "address_resolver": "defaultDns",
        "address_strategy": "ipv4_only",
        "detour": "🚀 节点选择"
      },
      {
        "tag": "localDns",
        "address": "223.5.5.5",
        "address_resolver": "defaultDns",
        "address_strategy": "ipv4_only",
        "detour": "🎯 全球直连"
      },
      {
        "tag": "defaultDns",
        "address": "223.5.5.5",
        "address_strategy": "ipv4_only",
        "detour": "🎯 全球直连"
      }
    ],
    "rules": [
      {
        "outbound": "any",
        "server": "defaultDns",
        "disable_cache": true
      },
      {
        "clash_mode": "direct",
        "server": "localDns"
      },
      {
        "clash_mode": "global",
        "server": "proxyDns"
      },
      {
        "rule_set": "GeoSite-CN",
        "server": "localDns"
      },
      {
        "rule_set": "GeoLocation-!CN",
        "server": "proxyDns"
      }
    ],
    "final": "localDns",
    "strategy": "ipv4_only"
  }
}
